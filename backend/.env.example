# Copy to .env.local for development. NEVER commit real values.

# development | staging | production. Mock OTP / mock payments are refused in production.
APP_ENV=development

# PostgreSQL connection string (Neon, Supabase, etc.). If empty in development,
# an embedded in-memory/file PGlite database is used. Required in staging/production.
DATABASE_URL=

# Long random strings (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef
OTP_SECRET=change-me-dev-only-fedcba9876543210fedcba9876543210

# OTP provider: mock (development only) | none
OTP_PROVIDER=mock
# apitxt.com SMS OTP (OTP_PROVIDER=apitxt): key from Dashboard -> API Keys; template id optional (integer).
APITXT_AUTH_KEY=
APITXT_TEMPLATE_ID=
MOCK_OTP_CODE=8899
# Set to true ONLY for a temporary demo on a deployed server. With the mock provider anyone who knows the
# demo code can log in as any mobile number. Remove as soon as a real OTP provider is connected.
ALLOW_DEMO_OTP=false

# Payment provider: mock (development only) | manual_upi
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=change-me-dev-only-webhook-secret

# First admin account, created by `npm run db:seed` (password min 12 chars)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# File storage. If empty in development, files are written to ./.uploads
BLOB_READ_WRITE_TOKEN=

